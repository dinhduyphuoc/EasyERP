# Required: local infrastructure
POSTGRES_USER=username
POSTGRES_PASSWORD=change-me
POSTGRES_DB=store
POSTGRES_PORT=5432
REDIS_PORT=6379

# Required: container and app ports
PORT=3001
BACKEND_PORT=3001
PROD_FRONTEND_PORT=8080

# Required: production images
EASYERP_BACKEND_IMAGE=dinhduyphuoc/easyerp-backend:latest
EASYERP_FRONTEND_IMAGE=dinhduyphuoc/easyerp-frontend:latest

# Required: app runtime
DB_CONNECTION=local-pg
CORS_ORIGIN=https://app.example.com
PROD_CORS_ORIGIN=https://app.example.com
REDIS_URL=redis://redis:6379
RUN_DB_MIGRATIONS=false
RUN_DB_SEED=false

# Required: backend database connection
DATABASE_URL=postgresql://username:change-me@db:5432/store?schema=public
SHADOW_DATABASE_URL=postgresql://username:change-me@db:5432/store_shadow?schema=public

# Optional: external integrations
GHN_GATEWAY_ORIGIN=https://online-gateway.ghn.vn
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

# Optional: AWS S3 upload
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=

# Optional: workspace defaults
DEFAULT_TENANT_NAME=Default Tenant
DEFAULT_TENANT_SLUG=default

# Recommended: seed admin for first login
SUPER_ADMIN_FULL_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
