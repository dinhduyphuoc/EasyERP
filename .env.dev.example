# Required: local infrastructure
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=store
POSTGRES_PORT=5432
REDIS_PORT=6379

# Required: container and app ports
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=5173
PROD_FRONTEND_PORT=8080

# Required: frontend -> backend URL
VITE_API_URL=http://localhost:3001

# Required: app runtime
DB_CONNECTION=local-pg
CORS_ORIGIN=http://localhost:5173
DEV_CORS_ORIGIN=http://localhost:5173
PROD_CORS_ORIGIN=http://localhost:8080
REDIS_URL=redis://redis:6379
AUTO_DB_PUSH=false
RUN_DB_MIGRATIONS=false
RUN_DB_SEED=false

# Required: backend database connection
DATABASE_URL=postgresql://username:password@db:5432/store?schema=public
SHADOW_DATABASE_URL=postgresql://username:password@db:5432/store_shadow?schema=public

# Optional: external integrations
GHN_GATEWAY_ORIGIN=https://dev-online-gateway.ghn.vn
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

# Optional: AWS S3 upload
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=

# Optional: workspace defaults
DEFAULT_TENANT_NAME=Default Tenant
DEFAULT_TENANT_SLUG=default

# Recommended: seed admin for first login
SUPER_ADMIN_FULL_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
