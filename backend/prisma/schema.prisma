// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Naming convention for this schema:
// - Model names use singular PascalCase, for example `Order`, `Customer`, `City`.
// - Scalar fields and relation fields use snake_case, for example `created_at`, `category_id`, `attribute_value_id`.
// - New Prisma models/fields must follow this convention directly to keep AI/codegen output consistent.
// - Only use `@@map` / `@map` for legacy database objects that cannot be renamed yet.

model Category {
  id            Int    @id @default(autoincrement())
  category_name String
  products      Product[]

}

model SalesChannel {
  id           Int     @id @default(autoincrement())
  channel_name String

}

model OrderStatus {
  id          Int     @id @default(autoincrement())
  status_name String

}

model ShippingUnit {
  id        Int     @id @default(autoincrement())
  unit_name String

}

model ShippingProvider {
  id                Int                  @id @default(autoincrement())
  code              String               @unique
  display_name      String
  short_description String?
  logo_url          String?
  is_active         Boolean              @default(true)
  capabilities_json Json                 @default("{}")
  created_at        DateTime             @default(now())
  updated_at        DateTime             @default(now()) @updatedAt

  connections       ShippingConnection[]

  @@index([is_active])
}

model ShippingConnection {
  id               Int                      @id @default(autoincrement())
  provider_id      Int
  store_id         String
  status           ShippingConnectionStatus @default(disconnected)
  credentials_json Json?
  metadata_json    Json                     @default("{}")
  error_message    String?
  last_sync_at     DateTime?
  last_verified_at DateTime?
  connected_at     DateTime?
  disconnected_at  DateTime?
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @default(now()) @updatedAt

  provider         ShippingProvider         @relation(fields: [provider_id], references: [id])
  history_items    ShippingConnectionHistory[]

  @@unique([provider_id, store_id])
  @@index([store_id])
  @@index([status])
}

model ShippingConnectionHistory {
  id             Int                      @id @default(autoincrement())
  connection_id  Int
  action         String
  status         ShippingConnectionStatus
  store_id       String
  provider_code  String
  payload_json   Json                     @default("{}")
  error_message  String?
  actor_id       String?
  actor_name     String?
  created_at     DateTime                 @default(now())

  connection     ShippingConnection       @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@index([connection_id, created_at])
  @@index([store_id, provider_code])
}

enum ProductStatus {
  active
  inactive
  draft
  deleted
}

enum ProductVariantStatus {
  active
  inactive
  deleted
}

enum CustomerStatus {
  active
  inactive
  soft_deleted
  deleted
}

enum CustomerGender {
  male
  female
  other
}

enum OrderPaymentStatus {
  unpaid
  paid
  deposit
}

enum OrderProcessingStatus {
  draft
  placed
  confirmed
  picked_up
  delivering
  completed
  cancelled
  returned
}

enum OrderType {
  sale
  return
}

enum ShippingConnectionStatus {
  disconnected
  connected
  error
}

enum CustomerAddressType {
  billing
  shipping
  office
  warehouse
  other
}

// ---------------------------------------------------------
// 2. Nhóm Sản phẩm
// ---------------------------------------------------------

model Product {
  id           Int      @id @default(autoincrement())
  product_name String
  sku          String?   @unique
  unit         String?   
  base_price   Decimal?  @db.Decimal(12, 2)
  cogs         Decimal?  @db.Decimal(12, 2)
  image_url    String?
  status       ProductStatus @default(draft)
  description  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  category_id  Int?
  category     Category? @relation(fields: [category_id], references: [id])

  attributes Attribute[]
  variants   ProductVariant[]
  order_items OrderItem[]

}

model Attribute {
  id         Int     @id @default(autoincrement())
  name       String // "MÃ u sáº¯c", "Size", "Cháº¥t liá»‡u"
  product_id   Int
  product      Product @relation(fields: [product_id], references: [id])

  values AttributeValue[]

}

model AttributeValue {
  id           Int       @id @default(autoincrement())
  value        String // "Äá»", "Xanh", "Size 32"...
  attribute_id  Int
  attribute     Attribute @relation(fields: [attribute_id], references: [id])

  variant_links VariantAttributeValue[]

}

model ProductVariant {
  sku              String                  @id
  product_id       Int
  product          Product                 @relation(fields: [product_id], references: [id])
  selling_price    Decimal                 @db.Decimal(12, 2)
  cogs             Decimal                 @default(0) @db.Decimal(12, 2)
  image_url        String?
  status           ProductVariantStatus    @default(active)
  created_at       DateTime                @default(now())
  updated_at       DateTime                @default(now()) @updatedAt
  attribute_values VariantAttributeValue[]
  order_items      OrderItem[]
  inventory_stock  InventoryStock?
  inventory_transactions InventoryTransaction[]
  inventory_audit_lines InventoryAuditLine[]
  // --------------------------------------------

}

enum InventoryTransactionType {
  initialize
  adjust
  reserve
  release
  move_to_packing
  pack_cancel
  fulfill
  return_restock
  incoming_create
  incoming_receive
}

enum InventoryReasonCode {
  initialize
  actual_count
  damaged
  customer_return
  transfer
  manufacturing
  lost
  order_reserved
  order_released
  packing_started
  packing_cancelled
  order_fulfilled
  purchase_incoming
  purchase_received
  other
}

enum InventoryFieldName {
  on_hand
  available
  committed
  packing
  incoming
}

enum InventoryAuditStatus {
  draft
  completed
}

model VariantAttributeValue {
  variant_sku       String
  attribute_value_id Int

  variant          ProductVariant @relation(fields: [variant_sku], references: [sku])
  attribute_value  AttributeValue @relation(fields: [attribute_value_id], references: [id])

  @@id([variant_sku, attribute_value_id])
}

// ---------------------------------------------------------
// 3. NhÃ³m KhÃ¡ch hÃ ng & Äá»‹a lÃ½
// ---------------------------------------------------------

model CustomerCategory {
  id              Int        @id @default(autoincrement())
  category_code   String?    @unique
  category_name   String
  normalized_name String
  is_active       Boolean    @default(true)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now()) @updatedAt

  customers       Customer[]

  @@unique([normalized_name])
}

model Customer {
  id                   Int               @id @default(autoincrement())
  client_code          String            @unique
  full_name            String
  phone                String?
  email                String?
  birth_date           DateTime?
  gender               CustomerGender?
  tax_code             String?
  status               CustomerStatus    @default(active)
  customer_category_id Int?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @default(now()) @updatedAt

  customer_category    CustomerCategory? @relation(fields: [customer_category_id], references: [id])
  orders               Order[]
  addresses            CustomerAddress[]

  @@index([full_name])
  @@index([client_code])
  @@index([phone])
  @@index([status])
  @@index([email])
  @@index([tax_code])
}

model Location {
  id          Int    @id @default(autoincrement())
  state       String // Tá»‰nh/ThÃ nh
  city        String // Quáº­n/Huyá»‡n
  district    String // PhÆ°á»ng/XÃ£

}

// ---------------------------------------------------------
// 4. NhÃ³m ÄÆ¡n hÃ ng
// ---------------------------------------------------------

model State {
  id              Int        @id @default(autoincrement())
  code            String     @unique
  name            String
  normalized_name String     @unique
  is_active       Boolean    @default(true)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now()) @updatedAt

  cities          City[]
  addresses       Address[]
}

model City {
  id              Int        @id @default(autoincrement())
  state_id        Int
  code            String
  name            String
  normalized_name String
  is_active       Boolean    @default(true)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @default(now()) @updatedAt

  state           State      @relation(fields: [state_id], references: [id])
  districts       District[]
  addresses       Address[]

  @@unique([state_id, code])
  @@unique([state_id, normalized_name])
  @@index([state_id])
}

model District {
  id              Int       @id @default(autoincrement())
  city_id         Int
  code            String
  name            String
  normalized_name String
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt

  city            City      @relation(fields: [city_id], references: [id])
  addresses       Address[]

  @@unique([city_id, code])
  @@unique([city_id, normalized_name])
  @@index([city_id])
}

model Address {
  id             Int       @id @default(autoincrement())
  state_id       Int
  city_id        Int
  district_id    Int?
  address_line   String
  address_line2  String?
  state_name     String
  city_name      String
  district_name  String?
  postal_code    String?
  country_code   String    @default("VN")
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  note           String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  state          State     @relation(fields: [state_id], references: [id])
  city           City      @relation(fields: [city_id], references: [id])
  district       District? @relation(fields: [district_id], references: [id])
  customers      CustomerAddress[]
  orders_from    Order[]   @relation("OrderFromAddress")
  orders_to      Order[]   @relation("OrderToAddress")
  orders_return  Order[]   @relation("OrderReturnAddress")

  @@index([state_id])
  @@index([city_id])
  @@index([district_id])
}

model CustomerAddress {
  id              Int                 @id @default(autoincrement())
  customer_id     Int
  address_id      Int
  type            CustomerAddressType @default(shipping)
  label           String?
  is_default      Boolean             @default(false)
  recipient_name  String?
  recipient_phone String?
  note            String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @default(now()) @updatedAt

  customer        Customer            @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  address         Address             @relation(fields: [address_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, address_id, type])
  @@index([customer_id])
  @@index([address_id])
  @@index([type])
  @@index([is_default])
}

model Order {
  id                        Int                   @id @default(autoincrement())
  order_code                String                @unique
  order_type                OrderType             @default(sale)
  order_date                DateTime              @default(now())
  customer_id               Int?
  customer                  Customer?             @relation(fields: [customer_id], references: [id])
  customer_code             String?
  customer_name             String
  customer_phone            String
  customer_email            String?
  customer_address          String?
  client_order_code         String?
  note                      String?
  required_note             String?
  payment_type_id           Int?
  from_address_id           Int?
  to_address_id             Int?
  return_address_id         Int?
  from_name                 String?
  from_phone                String?
  from_address              String?
  from_ward_name            String?
  from_district_name        String?
  from_province_name        String?
  return_phone              String?
  return_address            String?
  return_district_id        Int?
  return_ward_code          String?
  to_ward_code              String?
  to_district_id            Int?
  cod_amount                Decimal               @default(0) @db.Decimal(12, 2)
  content                   String?
  weight                    Int?
  length                    Int?
  width                     Int?
  height                    Int?
  insurance_value           Decimal               @default(0) @db.Decimal(12, 2)
  service_id                Int?
  service_type_id           Int?
  pick_station_id           Int?
  deliver_station_id        Int?
  coupon                    String?
  pick_shift                Int[]                 @default([])
  sub_total                 Decimal               @default(0) @db.Decimal(12, 2)
  tax_amount                Decimal               @default(0) @db.Decimal(12, 2)
  shipping_fee              Decimal               @default(0) @db.Decimal(12, 2)
  total_amount              Decimal               @default(0) @db.Decimal(12, 2)
  deposit_amount            Decimal               @default(0) @db.Decimal(12, 2)
  paid_amount               Decimal               @default(0) @db.Decimal(12, 2)
  outstanding_amount        Decimal               @default(0) @db.Decimal(12, 2)
  payment_status            OrderPaymentStatus    @default(unpaid)
  processing_status         OrderProcessingStatus @default(draft)
  shipping_service          String?
  sales_channel             String?
  order_notes               String?
  payment_notes             String?
  warehouse_status          String?
  tracking_code             String?
  shipping_status           String?
  invoice_code              String?
  created_by                String?
  confirmed_by              String?
  status_timeline           Json                  @default("{}")
  created_at                DateTime              @default(now())
  updated_at                DateTime              @default(now()) @updatedAt

  items                     OrderItem[]
  history                   OrderHistory[]
  from_address_detail       Address?              @relation("OrderFromAddress", fields: [from_address_id], references: [id])
  to_address_detail         Address?              @relation("OrderToAddress", fields: [to_address_id], references: [id])
  return_address_detail     Address?              @relation("OrderReturnAddress", fields: [return_address_id], references: [id])

  @@index([order_code])
  @@index([order_date])
  @@index([payment_status])
  @@index([processing_status])
  @@index([order_type])
  @@index([customer_id])
  @@index([from_address_id])
  @@index([to_address_id])
  @@index([return_address_id])
}

model OrderItem {
  id                  Int            @id @default(autoincrement())
  order_id            Int
  order               Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id          Int?
  product             Product?       @relation(fields: [product_id], references: [id])
  variant_sku         String?
  variant             ProductVariant? @relation(fields: [variant_sku], references: [sku])
  product_name        String
  sku                 String
  quantity            Int
  unit_price          Decimal        @db.Decimal(12, 2)
  discount_amount     Decimal        @default(0) @db.Decimal(12, 2)
  sub_total           Decimal        @db.Decimal(12, 2)
  notes               String?
  item_weight         Int?
  item_length         Int?
  item_width          Int?
  item_height         Int?
  category_level1     String?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @default(now()) @updatedAt

  @@index([order_id])
  @@index([product_id])
  @@index([variant_sku])
}

model OrderHistory {
  id                  Int      @id @default(autoincrement())
  order_id            Int
  order               Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  event_type          String
  description         String
  actor_name          String?
  metadata            Json     @default("{}")
  created_at          DateTime @default(now())

  @@index([order_id, created_at(sort: Desc)])
}

// ---------------------------------------------------------
// 5. Kho váº­n
// ---------------------------------------------------------

model InventoryStock {
  id                 Int      @id @default(autoincrement())
  product_variant_id String   @unique
  on_hand            Int      @default(0)
  available          Int      @default(0)
  committed          Int      @default(0)
  packing            Int      @default(0)
  incoming           Int      @default(0)
  version            Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  product_variant ProductVariant @relation(fields: [product_variant_id], references: [sku])

  @@map("InventoryStock")
}

model InventoryTransaction {
  id                 Int                      @id @default(autoincrement())
  product_variant_id String
  transaction_type   InventoryTransactionType
  reason_code        InventoryReasonCode
  reference_type     String?
  reference_id       String?
  reference_code     String?
  actor_id           String?
  actor_name         String?
  note               String?
  idempotency_key    String?                  @unique
  metadata_json      Json                     @default("{}")
  created_at         DateTime                 @default(now())

  product_variant ProductVariant            @relation(fields: [product_variant_id], references: [sku])
  lines           InventoryTransactionLine[]

  @@index([product_variant_id, created_at(sort: Desc)])
  @@index([reference_type, reference_id])
  @@map("InventoryTransaction")
}

model InventoryAudit {
  id                    Int                  @id @default(autoincrement())
  audit_code            String               @unique
  status                InventoryAuditStatus @default(draft)
  note                  String?
  account_id            String?
  account_name          String?
  counted_at            DateTime?
  completed_at          DateTime?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt

  lines                 InventoryAuditLine[]

  @@index([status, created_at(sort: Desc)])
  @@map("InventoryAudit")
}

model InventoryAuditLine {
  id                    Int             @id @default(autoincrement())
  audit_id              Int
  product_variant_id    String
  system_on_hand        Int
  counted_on_hand       Int?
  delta_qty             Int?
  note                  String?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  audit                 InventoryAudit  @relation(fields: [audit_id], references: [id], onDelete: Cascade)
  product_variant       ProductVariant  @relation(fields: [product_variant_id], references: [sku])

  @@unique([audit_id, product_variant_id])
  @@index([audit_id])
  @@index([product_variant_id])
  @@map("InventoryAuditLine")
}

model InventoryTransactionLine {
  id                 Int                @id @default(autoincrement())
  transaction_id     Int
  field_name         InventoryFieldName
  delta_value        Int
  value_after_change Int
  created_at         DateTime           @default(now())

  transaction InventoryTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@unique([transaction_id, field_name])
  @@index([transaction_id])
  @@map("InventoryTransactionLine")
}