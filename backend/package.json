{
  "name": "backend",
  "version": "1.0.0",
  "description": "EasyERP backend",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:backfill:order-vat": "tsx scripts/backfill-order-vat-snapshots.ts",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --shadow-database-url %DATABASE_DEVELOPMENT_SHADOW_URL% --script",
    "db:studio": "prisma studio",
    "db:test": "tsx scripts/test-db-connection.ts",
    "seed": "tsx script.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:address:generate": "python scripts/generate_address_seed.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "argon2": "^0.44.0",
    "aws-sdk": "^2.1693.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "sharp": "^0.34.5",
    "vietqr": "^1.1.9"
  }
}
