PORT=3001

# Database
DB_CONNECTION=aws-pg
RDSHOST=your-rds-endpoint.ap-southeast-2.rds.amazonaws.com
DATABASE_URL=postgresql://postgres@your-rds-endpoint.ap-southeast-2.rds.amazonaws.com:5432/store?sslmode=verify-full&sslrootcert=./global-bundle.pem&schema=public
CORS_ORIGIN=http://localhost:5173,https://app.ddphuoc.site

# GHN API
GHN_GATEWAY_ORIGIN=https://dev-online-gateway.ghn.vn

# AWS Postgres
AWS_PG_REGION=ap-southeast-2
AWS_PG_HOST=your-rds-endpoint.ap-southeast-2.rds.amazonaws.com
AWS_PG_PORT=5432
AWS_PG_DATABASE=store
AWS_PG_USER=postgres
AWS_PG_PASSWORD=
AWS_PG_SCHEMA=public
AWS_PG_SSL_CA_PATH=./global-bundle.pem

# AWS S3
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=

# Default workspace
DEFAULT_TENANT_NAME=Default Tenant
DEFAULT_TENANT_SLUG=default

# Super admin seed
SUPER_ADMIN_FULL_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# VietQR API
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
